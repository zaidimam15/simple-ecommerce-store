# ==============================================================================
# Simple E-commerce Store - Root .gitignore
# ==============================================================================

# Node dependencies across root and all subdirectories
node_modules/
*/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment and Secret configuration files (CRITICAL: NEVER COMMIT)
.env
.env.*
*.env
backend/.env
backend/.env.*
frontend/.env
frontend/.env.*
!.env.example
!backend/.env.example
!frontend/.env.example

# Production builds & compile artifacts
dist/
dist-ssr/
build/
*/dist/
*/build/
.vite/
*/.vite/

# Testing coverage & temporary scratch files
coverage/
*/coverage/
scratch/
tmp/
temp/

# Log files
*.log
logs/
*.pid
*.seed

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Thumbs.db:encryptable

# IDE / Editor config
.idea/
*.sublime-project
*.sublime-workspace
.vscode/*
!.vscode/extensions.json
*.swp
*.swo

# Stray terminal output artifacts
{
backend/Found
backend/console.log*
backend/x.category*
