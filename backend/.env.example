# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection String (Local or MongoDB Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/simple_ecommerce

# JSON Web Token Secret (Provide a secure random string in local .env)
JWT_SECRET=your_jwt_secret_key_here_change_in_production

# Client / Frontend URL for CORS
CLIENT_URL=http://localhost:5173

# Payment Configuration
# This store uses built-in Cash on Delivery (COD). No third-party payment gateway credentials are required.
PAYMENT_METHOD=Cash on Delivery
